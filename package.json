{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "start:prod": "node dist-server/server.mjs",
    "build": "vite build",
    "build:pages-routes": "node scripts/build-pages-routes.mjs",
    "build:release-manifest": "node scripts/generate-release-manifest.mjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-codebase.mjs",
    "verify:routing": "node scripts/verify-clean-routing.mjs",
    "verify:routing:dist": "node scripts/verify-clean-routing.mjs --dist",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/corporate-profile.test.ts tests/corporate-resources.test.ts tests/corporate-identity-regression.test.ts tests/enterprise-routing.test.ts tests/portal-login-modernization.test.ts tests/voice-continuous-conversation.test.ts",
    "test:integration": "node --import tsx --test tests/natural-conversational-ai.test.ts tests/ai-frontdesk-platform.test.ts tests/gemini-live-upgrade.test.ts tests/client-portal.test.ts tests/dual-recipient-notifications.test.ts tests/deployment-integration.test.ts tests/enterprise-stabilization.test.ts tests/phase1-stabilization.test.ts tests/master-enterprise-repair.test.ts tests/master-bulk-repair-dti001.test.ts tests/dti-bulk-repair-002-verification.test.ts tests/dti-master-completion-003.test.ts",
    "test:security": "node --import tsx --test tests/security-hardening-regression.test.ts tests/corporate-governance-regression.test.ts tests/gemini-live-upgrade.test.ts tests/master-bulk-repair-dti001.test.ts tests/dti-bulk-repair-002-verification.test.ts tests/dti-master-completion-003.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.7",
    "vite": "^8.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
