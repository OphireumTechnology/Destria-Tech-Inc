# CPU Profile — CI, local development & low-concurrency staging smoke tests
# GPLv3 espeak-ng is intentionally OMITTED per DESTRIA governance policy.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    COMPUTE_DEVICE=cpu \
    WHISPER_COMPUTE_TYPE=int8 \
    ALLOW_ESPEAK_GPL_FALLBACK=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/ai-inference
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY THIRD_PARTY_NOTICES.md ./

RUN useradd --create-home --uid 10001 inference
USER inference

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/v1/livez || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
