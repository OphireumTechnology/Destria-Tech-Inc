# GPU Profile — Recommended for live staging & production website voice receptionist
# GPLv3 espeak-ng is intentionally OMITTED per DESTRIA governance policy.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    COMPUTE_DEVICE=cuda \
    WHISPER_COMPUTE_TYPE=float16 \
    ALLOW_ESPEAK_GPL_FALLBACK=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3-pip \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/ai-inference
COPY requirements.txt ./
RUN python3.11 -m pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY THIRD_PARTY_NOTICES.md ./

RUN useradd --create-home --uid 10001 inference
USER inference

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/v1/livez || exit 1

CMD ["python3.11", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
